{
  "name": "slot-booking-api",
  "version": "1.0.0",
  "private": true,
  "description": "A capacity-aware event booking REST API built with Node.js and PostgreSQL.",
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node src/db/migrate.js",
    "check": "node scripts/check-syntax.js"
  },
  "dependencies": {
    "bcryptjs": "3.0.2",
    "express": "5.1.0",
    "express-rate-limit": "8.6.1",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.2",
    "pg": "8.23.0",
    "zod": "4.3.0"
  }
}
